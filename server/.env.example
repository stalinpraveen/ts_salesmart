# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tssalesmart?retryWrites=true&w=majority

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Used by the seed script to create the first admin (Phase 6)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary (Phase 8)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
